{
  "name": "circular/protocol-api",
  "description": "Official PHP SDK for Circular Protocol blockchain operations and wallet management",
  "version": "1.0.9",
  "type": "library",
  "keywords": [
    "blockchain",
    "circular",
    "protocol",
    "sdk",
    "api",
    "crypto",
    "web3"
  ],
  "homepage": "https://github.com/circular-protocol/circular-php",
  "license": "MIT",
  "authors": [
    {
      "name": "Danny De Novi",
      "email": "dev@circular.org"
    }
  ],
  "require": {
    "php": "^8.0",
    "ext-curl": "*",
    "ext-json": "*",
    "phpseclib/phpseclib": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "Circular\\Protocol\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Circular\\Protocol\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "test:e2e": "phpunit --testsuite e2e",
    "test:coverage": "phpunit --coverage-html coverage",
    "cs:check": "phpcs src tests",
    "cs:fix": "phpcbf src tests",
    "phpstan": "phpstan analyse src tests"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
